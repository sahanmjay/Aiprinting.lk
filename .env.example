# Server-only (Vercel env vars). Never prefix these with VITE_.
# PAYHERE_MODE: exactly "live" or "sandbox". Missing or anything else = online payment is refused.
PAYHERE_MODE=
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
# Final https domain with no redirect and no trailing slash. Required in live mode.
SITE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public (shipped in the browser bundle; also read by the API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
